# Backend has prefix /api (see backend_max/app/main.py).
# Empty or /api = Vite proxy → localhost:8000 (vite.config.ts)
VITE_API_BASE_URL=/api

# true = in-memory mocks; false = real FastAPI (default for Docker build)
VITE_USE_MOCK_API=false

# Optional: override Vite proxy target
# VITE_PROXY_TARGET=http://localhost:8000
