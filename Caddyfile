# Caddy: HTTPS-вход для B2B Match
# - отдаёт production-сборку фронта из /srv/frontend (см. Dockerfile.caddy)
# - проксирует /api/* (и docs/health) на backend:8000
#
# TLS (automatic HTTPS):
# - DOMAIN=localhost          → локальный CA Caddy (самоподписанный)
# - DOMAIN=<ip>.nip.io        → Let's Encrypt (нужен публичный IP + открытые 80/443)
# - DOMAIN=ваш-домен.ru       → Let's Encrypt
#
# Без публичного 80/443 LE не выпустится — тогда DOMAIN=localhost
# или раскомментируй tls internal.

{
	email {$ACME_EMAIL}
}

{$DOMAIN:localhost} {
	# Automatic HTTPS:
	# - localhost / *.localhost → локальный CA Caddy
	# - публичный хост (x.x.x.x.nip.io, свой домен) → Let's Encrypt
	# Если LE недоступен (нет белого IP / 80 закрыт) — раскомментируй:
	# tls internal

	encode zstd gzip

	# --- API бэкенда (все ручки под /api) ---
	handle /api* {
		reverse_proxy backend:8000
	}
	handle /health {
		reverse_proxy backend:8000
	}
	handle /docs* {
		reverse_proxy backend:8000
	}
	handle /openapi.json {
		reverse_proxy backend:8000
	}
	handle /redoc {
		reverse_proxy backend:8000
	}

	# --- фронтенд мини-приложения (SPA) ---
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}
