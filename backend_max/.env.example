# ===== B2B Match backend =====

# Токен чат-бота MAX (платформа для партнёров). Нужен для:
#  - валидации initData мини-приложения (MAX Bridge)
#  - отправки уведомлений пользователям через Bot API
BOT_TOKEN=

# Секрет для подписи JWT-токенов бэкенда. Обязательно смените в проде.
JWT_SECRET=change_me
JWT_TTL_HOURS=168

# Строка подключения SQLAlchemy (PostgreSQL).
# В Docker compose эта переменная задаётся автоматически (сервис db).
# Для локального запуска без compose используйте localhost:5432 (порт пробрасывается compose).
DATABASE_URL=postgresql+psycopg2://b2b:b2b_pass@localhost:5432/b2b_match

# Параметры PostgreSQL (используются compose.yaml, если не заданы в .env)
POSTGRES_USER=b2b
POSTGRES_PASSWORD=b2b_pass
POSTGRES_DB=b2b_match

# Caddy (HTTPS-вход)
# Локально: DOMAIN=localhost (самоподписанный сертификат).
# Продакшен: DOMAIN=ваш-домен.ru + удалите "tls internal" в Caddyfile —
# Caddy выпустит сертификат Let's Encrypt автоматически.
DOMAIN=localhost
ACME_EMAIL=

# 1 = отключить проверку SSL-сертификата (сертификат Минцифры),
# после установки корневых CA поставить 0
MAX_SSL_VERIFY=0

# DEV_MODE=1 разрешает:
#  - вход без валидного initData (для локальной разработки и демо)
#  - POST /auth/max с dev_max_user_id (вход под seed-пользователем)
# В проде ОБЯЗАТЕЛЬНО ставить 0.
DEV_MODE=1

# Допустимый возраст initData в секундах (защита от replay)
INITDATA_MAX_AGE=86400

# Порог и количество рекомендаций
MIN_MATCH_SCORE=60
TOP_MATCHES=5

# id пользователей MAX (через запятую), которые получают права администратора платформы.
# 7777001 — админ в демо-данных (seed)
MAX_ADMIN_USER_IDS=7777001

# Опционально: LLM для Smart Request Builder (OpenAI-совместимый API).
# Если не заданы — используется правило-структуризатор.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Каталог хранения загруженных файлов (в Docker — внутри тома ./data)
FILES_DIR=./data/files
